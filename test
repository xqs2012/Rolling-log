// ==================== Toast 弹框 ====================
function showToast(msg) {
    const existing = document.querySelector('.toast');
    if (existing) existing.remove();
    const toast = document.createElement('div');
    toast.className = 'toast';
    toast.textContent = msg;
    document.body.appendChild(toast);
    setTimeout(() => { if (toast.parentNode) toast.remove(); }, 3000);
}

function escapeHtml(str){
    return String(str ?? '')
        .replace(/&/g,'&amp;')
        .replace(/</g,'&lt;')
        .replace(/>/g,'&gt;')
        .replace(/"/g,'&quot;')
        .replace(/'/g,'&#39;');
}

const ADMIN_NICKNAME = 'xqs';
const ADMIN_PASSWORD = '1006';

function isAdminUnlocked(){
    return S.isAdmin || sessionStorage.getItem('rollwood_admin_verified') === '1';
}
function loadRankings(){
    try{
        return JSON.parse(localStorage.getItem('rollwood_rankings') || '{"fastest":[],"through":[]}') || {fastest:[],through:[]};
    }catch(e){
        return {fastest:[], through:[]};
    }
}
function rankingBetter(a, b, kind){
    if(!b) return true;
    const ad = Number(a?.days ?? 0);
    const bd = Number(b?.days ?? 0);
    if(kind === 'fastest') return ad < bd || (ad === bd && String(a.date||'') < String(b.date||''));
    return ad > bd || (ad === bd && String(a.date||'') < String(b.date||''));
}
function dedupeAndSortRanking(list, kind){
    const map = new Map();
    (Array.isArray(list) ? list : []).forEach(item => {
        const name = String(item?.name ?? '匿名').trim() || '匿名';
        const row = { name, days: Math.max(1, Number(item?.days ?? 1)), date: String(item?.date ?? '') };
        const old = map.get(name);
        if(!old || rankingBetter(row, old, kind)) map.set(name, row);
    });
    const arr = [...map.values()];
    arr.sort((a, b) => kind === 'fastest'
        ? (a.days - b.days || a.name.localeCompare(b.name, 'zh-Hans-CN') || String(a.date||'').localeCompare(String(b.date||'')))
        : (b.days - a.days || a.name.localeCompare(b.name, 'zh-Hans-CN') || String(a.date||'').localeCompare(String(b.date||'')))
    );
    return arr.slice(0, 10);
}
function normalizeRankings(data){
    return {
        fastest: dedupeAndSortRanking(data?.fastest || [], 'fastest'),
        through: dedupeAndSortRanking(data?.through || [], 'through')
    };
}
function saveRankings(data){
    localStorage.setItem('rollwood_rankings', JSON.stringify(normalizeRankings(data)));
    syncLeaderboardToCloud(normalizeRankings(data));
}
function loadSuggestions(){
    try{
        return JSON.parse(localStorage.getItem('rollwood_suggestions') || '[]') || [];
    }catch(e){
        return [];
    }
}
function saveSuggestions(list){
    localStorage.setItem('rollwood_suggestions', JSON.stringify(list));
}
function submitSuggestion(){
    const input = document.getElementById('suggestionInput');
    if(!input) return;
    const text = (input.value || '').trim();
    if(!text){
        showToast('请输入建议内容');
        return;
    }
    const list = loadSuggestions();
    list.unshift({
        text,
        name: S.playerName || '匿名',
        recipient: 'xqs',
        date: new Date().toISOString().slice(0,10)
    });
    saveSuggestions(list.slice(0, 50));
    input.value = '';
    renderRankings('leaderboardBox', true);
    renderRankings('startLeaderboardBox', false);
    showToast('建议已提交');
}
function recordWinRankings(){
    const data = loadRankings();
    const name = S.playerName || '匿名';
    const days = Math.max(1, S.day);
    const score = { name, days, date: new Date().toISOString().slice(0,10) };
    data.fastest.push(score);
    data.through.push(score);
    saveRankings(data);
}

