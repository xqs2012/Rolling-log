function useItem(name){if(!S.items.includes(name))return;S.items=S.items.filter(i=>i!==name);itemDefs[name].onUse();updateUI();}
function checkFound(baseChance){
    let chance = baseChance;
    if(S.location === 'classroom') chance += 10;
    if(S.location === 'hallway') chance *= 2; 
    if(S.buffs.studyBuff>0)chance=Math.floor(chance/2);
    if(S.weather==='雨天')chance-=10;
    if(S.affection>=30)chance-=5;
    if(S.spread>60)chance-=15;
    chance = Math.max(0, chance - (S._skillEffects.foundCut||0));
    if(Math.random()*100<chance){
        if(S.buffs.recorder){S.buffs.recorder=false;addLog('📱 录音笔抵消了被发现！','heal');S.foundCount++;return false;}
        S.foundCount++;S.dailyFoundCount++;S.pressure = Math.min(S.maxPressure, S.pressure + 3);
        return true;
    }
    return false;
}

function bossCounter(){
    if(S.bossHp<=0||!S.targeted)return;
    if(S.legalShields > 0){ S.legalShields--; addLog('🛡️ 法律护盾抵消了攻击！','heal'); grantExp(10); return; }
    if(S.buffs.amulet){S.buffs.amulet=false;addLog('🛡️ 护身符抵消了攻击！','heal'); grantExp(10); return;}
    if(S.buffs.dududuShield){S.buffs.dududuShield=false;addLog('🎵 dududu护盾抵消了攻击！','heal'); grantExp(10); return;}
    
    if(Math.random() < 0.25 && !S.mockeryMark) {
        S.mockeryMark = true;
        addLog('🦇 滚木盯上了你，发出了诡异的讥笑！你被施加了讥笑状态。', 'warn');
    }

    const atk=getBossAtk();let dmg=Math.floor(Math.random()*(atk.max-atk.min+1))+atk.min;
    if(S.bossHp<200)dmg=Math.floor(dmg*1.6);if(S.day===9)dmg*=2;const weekEff=getWeekEffect(S.day);
    if(weekEff[1]<0)dmg=Math.floor(dmg*0.8);if(S.dzzHpHalved)dmg=Math.floor(dmg*1.5);if(S.spread>90)dmg=Math.floor(dmg*0.8);
    const dealt = applyPlayerDamage(dmg);S.pressure = Math.min(S.maxPressure, S.pressure + 5);
    addLog(S.invincibleMode ? `👹 滚木【${atk.name}】！无效` : `👹 滚木【${atk.name}】！-${dealt}HP`,'dmg');
    if(atk.name==='踹门')document.getElementById('app').classList.add('shake');
    if(atk.name==='绝望反击')document.getElementById('app').classList.add('flash');
    setTimeout(()=>{document.getElementById('app').classList.remove('shake','flash')},300);
    if(S.playerHp<=0 && !S.gameOver){
        S.gameOver=true;S.victory=false;
        showOverlay('💀 你被击败...','','lose');
        addLog('💀 游戏结束');
        updateUI();
    }
    if(S.bossHp<500&&Math.random()<0.4){const dmg2=Math.floor(Math.random()*8)+3;const dealt2=applyPlayerDamage(dmg2,'小弟追加攻击');addLog(S.invincibleMode ? '👹 小弟追加攻击！无效' : `👹 小弟追加攻击！-${dealt2}HP`,'dmg');
        if(S.playerHp<=0 && !S.gameOver){
            S.gameOver=true;S.victory=false;
            showOverlay('💀 你被击败...','','lose');
            addLog('💀 游戏结束');
            updateUI();
        }
    }
}

