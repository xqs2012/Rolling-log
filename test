<script>
function skillNodeIcon(key,sk){
    const icons={body:['👊','⚔️','⛓️','🔥','🛡️','💀','🩸','☄️'],intelligence:['👁️','🔍','📂','🧠','🧩','📜','🎯'],cool:['📢','🔥','📈','⚖️','🛡️','🔇'],technical:['🧰','🔧','🤝','📦','⚡'],relic:['✨','🔮','🕯️','📖','🌌']};
    const arr=icons[key]||['✦']; const idx=Math.max(0,(sk.tier||1)-1); return arr[Math.min(idx,arr.length-1)];
}
function renderSkillTree(){
    const tabs=document.getElementById('skillTreeTabs'),body=document.getElementById('skillTreeBody');
    if(!tabs||!body)return;
    const keys=Object.keys(skillTreeData);
    tabs.innerHTML=keys.map(k=>{
        const tree=skillTreeData[k], learned=tree.perks.reduce((n,p)=>n+skillLevel(p.id),0), total=tree.perks.reduce((n,p)=>n+p.max,0);
        return `<button class="skill-tab ${S.currentSkillTab===k?'active':''}" style="border-color:${tree.color};color:${S.currentSkillTab===k?'#fff':tree.color}" onclick="setSkillTab('${k}')">${tree.name}<span style="opacity:.55;margin-left:4px">${learned}/${total}</span></button>`;
    }).join('');
    const tree=skillTreeData[S.currentSkillTab]; if(!tree)return;
    const learnedCount=tree.perks.reduce((n,p)=>n+skillLevel(p.id),0), totalLevels=tree.perks.reduce((n,p)=>n+p.max,0), pct=totalLevels?Math.round(learnedCount/totalLevels*100):0;
    const tiers=[...new Set(tree.perks.map(p=>p.tier||1))].sort((a,b)=>a-b);
    const tierHtml=tiers.map((tier,ti)=>{
        const perks=tree.perks.filter(p=>(p.tier||1)===tier);
        return `<section class="skill-tier"><div class="skill-tier-label">TIER ${tier}</div><div class="skill-tier-nodes">${perks.map(sk=>{
            const lv=skillLevel(sk.id), can=canLearnSkill(sk), maxed=lv>=sk.max, key=skillTreeKeyById(sk.id), attr=Number(S.attributes[key]||0), reqOK=attr>=sk.req;
            const state=maxed?'unlocked':(can?'ready':'locked');
            const desc=sk.desc[Math.min(Math.max(lv,1),sk.desc.length)-1]||sk.desc[0];
            const buttonText=maxed?'已达到上限':(can?(lv===0?'学习技能':'升级技能'):'条件未满足');
            return `<div class="skill-star-node ${state} ${sk.gold?'legendary':''}">
                <div class="skill-node-top"><div class="skill-node-rune">${skillNodeIcon(S.currentSkillTab,sk)}</div><div class="skill-node-level">Lv.${lv}/${sk.max}</div></div>
                <div class="skill-star-name">${sk.name}</div>
                <div class="skill-star-desc">${desc}</div>
                <div class="skill-star-require">
                    <span class="skill-chip ${reqOK?'ready':''}">属性 ${sk.req}</span>
                    <span class="skill-chip">${sk.gold?'终极':'核心'}</span>
                    ${sk.gold?'<span class="skill-chip gold">LEGEND</span>':''}
                    ${!can&&!maxed?'<span class="skill-chip">🔒</span>':''}
                </div>
                <button class="skill-action ${can?'ready':''}" onclick="learnSkill('${sk.id}')" ${can?'':'disabled'}>${buttonText}</button>
                ${ti<tiers.length-1?'<div class="skill-connector">↓</div>':''}
            </div>`;
        }).join('')}</div></section>`;
    }).join('');
    body.innerHTML=`<div class="skill-branch-head">
        <div class="skill-branch-main" style="color:${tree.color}"><div class="skill-branch-orb">✦</div><div class="skill-branch-copy"><div class="skill-branch-name">${tree.name}</div><div class="skill-branch-desc">${tree.desc}</div></div></div>
        <div class="skill-branch-progress"><div>${learnedCount}/${totalLevels} 级 · ${pct}% 完成</div><div class="skill-progress-line"><div class="skill-progress-fill" style="width:${pct}%"></div></div></div>
        <button class="skill-reset-btn" onclick="resetSkillTree()">🔄 重置 · 消耗1属性点</button>
    </div><div class="skill-constellation">${tierHtml}</div>`;
}
function setSkillTab(k){if(!skillTreeData[k])return;S.currentSkillTab=k;renderSkillTree();}
</script>


