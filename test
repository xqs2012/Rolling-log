/* 将地点行动做成统一的“地点卡”样式，而不修改原移动逻辑 */
(function enhanceMoveButtons(){
    const wrap=document.getElementById('actionsGrid');
    if(!wrap) return;

    const observer=new MutationObserver(()=>{
        const buttons=[...wrap.querySelectorAll('button')];
        buttons.forEach(btn=>{
            if(btn.dataset.ui44done) return;
            const txt=(btn.textContent||'').trim();
            if(!/消耗|移动|前往|教室|走廊|音乐|教务|天台|宿舍|操场/.test(txt)) return;

            btn.dataset.ui44done='1';
            btn.classList.add('ui44-move-btn');

            const original=btn.innerHTML;
            btn.innerHTML=`<span style="display:block">${original}</span>`;
        });
    });
    observer.observe(wrap,{childList:true,subtree:true});
})();

/* 排行榜内容更像正式游戏榜单 */
(function enhanceLeaderboard(){
    const box=document.getElementById('leaderboardBox');
    if(!box) return;
    const observer=new MutationObserver(()=>{
        box.querySelectorAll('.leaderboard-item').forEach((row,index)=>{
            if(row.dataset.ui44done) return;
            row.dataset.ui44done='1';

            const name=row.querySelector('.leaderboard-name');
            const days=row.querySelector('.leaderboard-days');
            if(!name) return;

            const date=(row.textContent.match(/\d{4}-\d{2}-\d{2}/)||[''])[0];
            row.classList.add('ui44-rank-row');
            row.innerHTML=`
              <div class="ui44-rank-num">${index+1}</div>
