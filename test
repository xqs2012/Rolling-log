
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>滚木规则怪谈</title>
    <style>
        *{margin:0;padding:0;box-sizing:border-box}
        body{
            font-family:"Microsoft YaHei","苹方","PingFang SC",sans-serif;
            background:#0a0a0a;color:#c0c0c0;min-height:100vh;
            display:flex;justify-content:center;align-items:center;padding:10px;
        }
        .container{
            max-width:950px;width:100%;background:linear-gradient(180deg,#1a1025 0%,#0f0a18 100%);
            border-radius:20px;padding:18px;box-shadow:0 0 60px rgba(180,40,40,0.2);border:1px solid #333;
            position:relative;overflow:hidden;
        }
        .toast{
            position:fixed;top:20px;left:20px;z-index:9999;
            background:rgba(0,0,0,0.9);color:#ffd700;
            border:1px solid #ff8800;border-left:4px solid #ff8800;
            border-radius:8px;padding:10px 16px;font-size:0.85em;
            max-width:350px;box-shadow:0 0 20px rgba(255,136,0,0.4);
            animation:slideIn 0.3s ease, fadeOut 0.5s ease 2.5s forwards;
            pointer-events:none;
        }
        @keyframes slideIn{from{transform:translateX(-100%);opacity:0}to{transform:translateX(0);opacity:1}}
        @keyframes fadeOut{from{opacity:1}to{opacity:0}}
        .shake{animation:shake 0.3s ease}
        .flash{animation:flash 0.2s ease}
        @keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-4px)}75%{transform:translateX(4px)}}
        @keyframes flash{0%,100%{opacity:1}50%{opacity:0.5;background:rgba(255,0,0,0.1)}}
        .header{text-align:center;margin-bottom:10px}
        .title{font-size:1.6em;color:#ff5555;text-shadow:0 0 25px rgba(255,60,60,0.5);letter-spacing:3px}
        .subtitle{color:#999;font-size:0.7em}
        .info-row{display:flex;gap:6px;margin-bottom:8px;flex-wrap:wrap}
        .info-cell{flex:1;min-width:70px;background:rgba(255,255,255,0.03);border-radius:8px;padding:6px;text-align:center;border:1px solid #2a2a2a}
        .info-cell .lbl{font-size:0.6em;color:#777;text-transform:uppercase;letter-spacing:1px}
        .info-cell .val{font-size:1em;font-weight:bold;margin-top:2px}
        .hp-section{display:flex;gap:10px;margin-bottom:8px}
        .hp-box{flex:1;background:#111;border-radius:10px;padding:8px 12px}
        .hp-box.player{border:2px solid #334488}
        .hp-box.boss{border:2px solid #552222}
        .hp-label{display:flex;justify-content:space-between;font-size:0.75em;margin-bottom:4px}
        .hp-outer{height:20px;background:#1a1a1a;border-radius:10px;overflow:hidden;border:1px solid #333}
        .hp-inner{height:100%;transition:width 0.4s ease;border-radius:10px}
        .hp-inner.player-hp{background:linear-gradient(90deg,#2266aa,#4488dd,#66aaee);box-shadow:inset 0 0 10px rgba(100,180,255,0.3)}
        .hp-inner.player-hp.low{animation:pulse 1s infinite}
        .hp-inner.boss-hp{background:linear-gradient(90deg,#aa2222,#dd4444,#ee5555);box-shadow:inset 0 0 10px rgba(255,80,80,0.3)}
        .hp-inner.boss-hp.low{animation:pulse 0.5s infinite}
        @keyframes pulse{0%,100%{opacity:1}50%{opacity:0.6}}
        .bar-section{background:#111;border-radius:8px;padding:6px 12px;margin-bottom:6px;border:1px solid #2a2a2a}
        .bar-header{display:flex;justify-content:space-between;font-size:0.7em;margin-bottom:3px}
        .bar-outer{height:12px;background:#1a1a1a;border-radius:6px;overflow:hidden}
        .ap-inner{height:100%;background:linear-gradient(90deg,#6644aa,#8866cc);transition:width 0.3s;border-radius:6px}
        .aff-inner{height:100%;background:linear-gradient(90deg,#ff4444,#ff8800,#ffcc00,#44cc44);transition:width 0.4s;border-radius:6px}
        .spread-inner{height:100%;background:linear-gradient(90deg,#4488cc,#66bbff);transition:width 0.5s;border-radius:6px}
        .pressure-inner{height:100%;background:linear-gradient(90deg,#8844cc,#cc66ff);transition:width 0.5s;border-radius:6px}
        .evidence-inner{height:100%;background:linear-gradient(90deg,#aaaaaa,#ffffff);transition:width 0.5s;border-radius:6px}
        .title-badge{display:inline-block;background:rgba(255,150,0,0.2);border:1px solid #ff8800;border-radius:15px;padding:2px 8px;font-size:0.7em;color:#ffaa00;margin:2px}
        .status-row{display:flex;gap:6px;margin-bottom:6px;flex-wrap:wrap;font-size:0.7em}
        .status-tag{padding:3px 8px;border-radius:12px;background:rgba(255,255,255,0.05);border:1px solid #333}
        .status-tag.active{background:rgba(255,170,0,0.15);border-color:#ff8800;color:#ffaa00}
        .cards-section{margin-bottom:6px}
        .cards-title{font-size:0.7em;color:#888;margin-bottom:4px}
        .cards-row{display:flex;gap:5px;flex-wrap:wrap}
        .card{flex:1;min-width:60px;background:rgba(255,255,255,0.02);border:2px solid #2a2a2a;border-radius:8px;padding:6px;text-align:center;font-size:0.65em;transition:all 0.3s}
        .card.owned{border-color:#ff8800;box-shadow:0 0 10px rgba(255,140,0,0.2);background:rgba(255,140,0,0.06);cursor:pointer}
        .card.owned:hover{border-color:#ffaa00;box-shadow:0 0 15px rgba(255,170,0,0.35);transform:translateY(-1px)}
        .card.locked{opacity:0.3;border-style:dashed}
        .card .ci{font-size:1.4em}
        .card .cn{font-weight:bold;color:#ffaa00;font-size:0.85em}
        .card .cd{color:#999;font-size:0.75em}
        .items-section{margin-bottom:6px}
        .items-row{display:flex;gap:5px;flex-wrap:wrap}
        .item{background:rgba(100,200,255,0.08);border:1px solid #4488aa;border-radius:6px;padding:4px 8px;font-size:0.65em;color:#88ccff;cursor:pointer}
        .item:hover{background:rgba(100,200,255,0.15)}
        .story-panel{background:rgba(0,0,0,0.35);border-radius:10px;padding:12px;margin-bottom:8px;border-left:3px solid #ff5555;min-height:45px}
        .story-text{font-size:0.85em;line-height:1.5;color:#ddd}
        .story-flavor{color:#ff9999;font-style:italic;font-size:0.75em;margin-top:3px}
        .attack-display{background:rgba(255,0,0,0.06);border-radius:8px;padding:6px 10px;margin-bottom:6px;font-size:0.7em;color:#ff7777;text-align:center;border:1px dashed #552222}
        .heal-hint{background:rgba(0,200,100,0.06);border-radius:8px;padding:5px 10px;margin-bottom:6px;font-size:0.7em;color:#55cc88;text-align:center;border:1px dashed #225544}
        .actions-label{font-size:0.7em;color:#888;margin-bottom:4px}
        .actions-grid{display:grid;grid-template-columns:1fr 1fr;gap:5px}
        @media(max-width:500px){.actions-grid{grid-template-columns:1fr}.hp-section{flex-direction:column}}
        .action-btn{padding:8px 10px;background:linear-gradient(135deg,#1a1a30 0%,#121228 100%);border:2px solid #2a2a2a;border-radius:8px;color:#ddd;cursor:pointer;font-size:0.8em;transition:all 0.2s;text-align:left;font-family:inherit;position:relative}
        .action-btn:hover:not(:disabled){border-color:#ff6666;transform:translateY(-1px);box-shadow:0 2px 10px rgba(255,50,50,0.12)}
        .action-btn:disabled{opacity:0.25;cursor:not-allowed}
        .action-btn .ap-tag{position:absolute;top:5px;right:6px;font-size:0.6em;color:#8866cc;font-weight:bold}
        .action-btn.attack-btn{border-color:#662222;background:linear-gradient(135deg,#2a1010 0%,#1a0808 100%)}
        .action-btn.zsy-btn{border-color:#886622;background:linear-gradient(135deg,#2a2010 0%,#1a1008 100%)}
        .action-btn.music-btn{border-color:#446644;background:linear-gradient(135deg,#102010 0%,#081008 100%)}
        .end-day-btn{width:100%;padding:8px;margin-top:6px;background:#1a1a30;border:2px solid #334466;border-radius:8px;color:#99bbee;cursor:pointer;font-size:0.85em;font-weight:bold;transition:all 0.3s;font-family:inherit}
        .end-day-btn:hover{background:#222240;box-shadow:0 0 15px rgba(60,80,180,0.2)}
        .log-section{margin-top:10px;background:rgba(0,0,0,0.3);border-radius:8px;padding:8px;max-height:110px;overflow-y:auto}
        .log-section h4{font-size:0.65em;color:#666;margin-bottom:5px}
        .log-entry{font-size:0.65em;padding:2px 0;border-bottom:1px solid #1a1a1a}
        .log-entry .tg{color:#8866cc;margin-right:3px}
        .log-entry.dmg{color:#ff7777}
        .log-entry.heal{color:#55cc88}
        .log-entry.card{color:#ffaa00}
        .log-entry.warn{color:#ff8844}
        .overlay{position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.9);display:flex;justify-content:center;align-items:center;z-index:100}
        .overlay-box{background:#1a1025;padding:25px;border-radius:20px;text-align:center;max-width:420px;border:2px solid;animation:fadeIn 0.5s}
        @keyframes fadeIn{from{opacity:0;transform:scale(0.9)}to{opacity:1;transform:scale(1)}}
        .overlay-box.win{border-color:#ffaa00;box-shadow:0 0 50px rgba(255,170,0,0.4)}
        .overlay-box.lose{border-color:#ff2222;box-shadow:0 0 50px rgba(255,0,0,0.4)}
        .overlay-box h2{font-size:1.4em;margin-bottom:8px}
        .overlay-box p{color:#ccc;margin-bottom:14px;line-height:1.5;font-size:0.85em}
        .overlay-box .lose-quote{color:#ff4444;font-size:1.1em;font-weight:bold;margin:12px 0;text-shadow:0 0 12px rgba(255,0,0,0.4)}
        .overlay-box .stats{text-align:left;font-size:0.75em;color:#aaa;margin:8px 0;line-height:1.6}
        .restart-btn{padding:8px 22px;background:#cc3333;color:white;border:none;border-radius:16px;font-size:0.9em;cursor:pointer;font-family:inherit;transition:all 0.3s}
        .restart-btn:hover{background:#ee4444;box-shadow:0 0 18px rgba(255,40,40,0.4)}
        .unlock-tracker{display:flex;gap:4px;margin-top:6px;flex-wrap:wrap}
        .unlock-node{flex:1;min-width:45px;text-align:center;font-size:0.6em;padding:3px;border-radius:5px;background:rgba(255,255,255,0.02);border:1px solid #2a2a2a;color:#666}
        .unlock-node.activated{border-color:#ff8800;color:#ffaa00;background:rgba(255,140,0,0.08);font-weight:bold}
        .unlock-node .unlock-icon{font-size:1.2em;display:block}
        .key-hint{position:absolute;bottom:8px;right:15px;font-size:0.55em;color:#555;pointer-events:none}
        .skillbar-row{display:flex;gap:8px;align-items:center;margin:6px 0 8px;flex-wrap:wrap}
        .skill-open-btn{padding:8px 12px;border-radius:10px;border:1px solid #4a4a8a;background:linear-gradient(135deg,#18182f 0%,#0f1020 100%);color:#d7d7ff;cursor:pointer;font-family:inherit;font-size:.8em;font-weight:bold}
        .skill-open-btn:hover{border-color:#8f7bff;box-shadow:0 0 14px rgba(120,90,255,.25)}
        .skill-reset-btn{padding:4px 10px;border-radius:8px;border:none;background:#a13232;color:#fff;cursor:pointer;font-size:0.75em;}
        .skill-meta{display:flex;gap:8px;flex-wrap:wrap;font-size:.65em;color:#aaa}
        .skill-meta span{padding:3px 8px;border:1px solid #2a2a2a;border-radius:999px;background:rgba(255,255,255,.03)}
        .skill-overlay{position:fixed;inset:0;z-index:200;background:rgba(0,0,0,.86);display:flex;justify-content:center;align-items:center;padding:12px}
        .skill-window{width:min(980px,100%);max-height:92vh;overflow:auto;background:linear-gradient(180deg,#131122 0%,#0b0b14 100%);border:1px solid #40336a;border-radius:18px;box-shadow:0 0 60px rgba(120,70,255,.18);padding:14px}
        .skill-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
        .skill-title{font-size:1.2em;color:#d6c7ff;letter-spacing:2px;font-weight:bold}
        .skill-close-btn{border:none;background:#2a173e;color:#fff;border-radius:10px;padding:8px 12px;cursor:pointer}
        .skill-close-btn:hover{background:#3a2254}
        .skill-topline{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:10px}
        .skill-topcard{background:rgba(255,255,255,.03);border:1px solid #2f2f49;border-radius:12px;padding:10px;text-align:center}
        .skill-toplbl{font-size:.65em;color:#8c8ca8;margin-bottom:4px}
        .skill-topval{font-size:1.1em;color:#fff;font-weight:bold}
        .skill-attr-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-bottom:10px}
        .skill-attr-card{background:rgba(255,255,255,.03);border:1px solid #2a2a3d;border-radius:12px;padding:10px}
        .skill-attr-name{font-size:.75em;color:#a7a7d7;margin-bottom:6px;font-weight:bold}
        .skill-attr-line{display:flex;justify-content:space-between;font-size:.68em;color:#9b9bb6;margin-bottom:6px}
        .skill-attr-btn{width:100%;border:none;border-radius:10px;padding:7px 8px;cursor:pointer;font-family:inherit;background:linear-gradient(135deg,#191a31 0%,#11111f 100%);color:#e7e7ff;border:1px solid #45456b}
        .skill-attr-btn:hover{border-color:#8f7bff}
        .skill-attr-btn:disabled{opacity:.35;cursor:not-allowed}
        .skill-tree-tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px}
        .skill-tab{border:1px solid #30304a;background:#11111c;color:#bbb;border-radius:999px;padding:7px 12px;cursor:pointer;font-family:inherit;font-size:.75em}
        .skill-tab.active{color:#fff;border-color:#8f7bff;box-shadow:0 0 12px rgba(140,100,255,.2)}
        .skill-tree-body{border:1px solid #28283f;border-radius:14px;background:rgba(255,255,255,.02);padding:12px}
        .skill-branch-title{font-size:.9em;color:#f0e7ff;margin-bottom:8px;font-weight:bold}
        .skill-branch-desc{font-size:.7em;color:#9d9db8;margin-bottom:10px}
        .skill-graph{display:grid;gap:10px}
        .skill-node{min-width:150px;max-width:210px;flex:1;background:linear-gradient(180deg,#171726 0%,#10101a 100%);border:1px solid #343454;border-radius:12px;padding:10px;position:relative;margin-bottom: 24px;}
        .skill-node:not(:last-child)::after { content:'⬇'; position:absolute; bottom:-22px; left:50%; transform:translateX(-50%); color:#7e63ff; font-size:18px; z-index:1;}
        .skill-node:last-child { margin-bottom: 0; }
        .skill-node.locked{opacity:.38;filter:grayscale(.35)}
        .skill-node.unlocked{border-color:#7e63ff;box-shadow:0 0 12px rgba(120,90,255,.12)}
        .skill-node.legendary{border-color:#ffb000;box-shadow:0 0 16px rgba(255,180,0,.18)}
        .skill-node-name{font-size:.82em;font-weight:bold;color:#fff;margin-bottom:4px}
        .skill-node-desc{font-size:.68em;color:#a7a7c2;line-height:1.45;min-height:34px}
        .skill-node-meta{display:flex;justify-content:space-between;margin-top:8px;font-size:.64em;color:#8f8fae}
        .skill-learn-btn{width:100%;margin-top:8px;padding:7px 8px;border:none;border-radius:10px;cursor:pointer;font-family:inherit;background:linear-gradient(135deg,#3d2b7a 0%,#241949 100%);color:#fff}
        .skill-learn-btn:hover{box-shadow:0 0 12px rgba(140,100,255,.22)}
        .skill-learn-btn:disabled{opacity:.35;cursor:not-allowed}
        .skill-badges{display:flex;gap:5px;flex-wrap:wrap;margin-top:8px}
        .skill-badge{font-size:.6em;padding:2px 6px;border-radius:999px;border:1px solid #333;color:#bbb;background:rgba(255,255,255,.03)}
        .skill-badge.req{border-color:#6d5aa8;color:#c9bfff}
        .skill-badge.perk{border-color:#745cff;color:#d9ccff}
        .skill-badge.gold{border-color:#ffb000;color:#ffd67c}
        .from-xqs{text-align:center;font-size:0.6em;color:#666;margin-top:10px;letter-spacing:1px}
        .task-btn{padding:8px 12px;border-radius:10px;border:1px solid #6a6a4a;background:linear-gradient(135deg,#2a2a1f 0%,#1a1a0f 100%);color:#ffd700;cursor:pointer;font-size:.8em;font-weight:bold;margin-left:8px}
        .task-overlay{position:fixed;inset:0;z-index:220;background:rgba(0,0,0,.88);display:flex;justify-content:center;align-items:center;padding:12px}
        .task-window{width:min(700px,100%);max-height:90vh;overflow:auto;background:linear-gradient(180deg,#1a1a2e 0%,#0f0f1e 100%);border:1px solid #aa8c4a;border-radius:18px;padding:18px;color:#ddd}
        .task-section{margin-bottom:16px;border-bottom:1px solid #333;padding-bottom:12px}
        .task-item{display:flex;justify-content:space-between;align-items:center;padding:6px 10px;background:rgba(255,255,255,0.03);border-radius:8px;margin:4px 0;font-size:0.8em}
        .task-reward{color:#ffd700;font-size:0.7em}
        .task-progress{color:#88ccff;font-size:0.7em}
        .ending-overlay{position:fixed;inset:0;z-index:500;background:rgba(0,0,0,0.95);display:flex;justify-content:center;align-items:center;padding:15px}
        .ending-box{max-width:600px;width:100%;background:linear-gradient(180deg,#0a0a0a 0%,#1a1025 100%);border:2px solid #ffaa00;border-radius:20px;padding:30px;text-align:center;color:#ddd;animation:fadeIn 1s}
        .ending-box h1{color:#ffaa00;font-size:1.8em;margin-bottom:15px}
        .ending-box .ending-text{line-height:2;font-size:0.9em;color:#ccc;margin-bottom:20px;min-height:200px}
        .ending-box .ending-reward{color:#ffd700;font-size:0.85em;margin-bottom:20px}
        .ending-choice-btn{padding:12px 24px;margin:8px;font-size:0.95em;font-family:inherit;border-radius:25px;cursor:pointer;transition:all 0.3s;background:transparent;color:#ddd;border:1px solid #555}
        .ending-choice-btn:hover{border-color:#ffaa00;color:#ffaa00;box-shadow:0 0 20px rgba(255,170,0,0.3)}
        .dlc-page{position:fixed;inset:0;z-index:700;background:linear-gradient(180deg,#0a0a0a 0%,#1a1025 100%);display:flex;flex-direction:column;align-items:center;padding:20px;overflow-y:auto}
        .dlc-page h1{color:#cc88ff;font-size:1.8em;margin:20px 0;text-align:center}
        .dlc-page .dlc-chapter-name{color:#888;font-size:1em;margin-bottom:20px;text-align:center}
        .dlc-page .dlc-content{max-width:650px;width:100%;line-height:2.2;font-size:0.95em;color:#ccc;white-space:pre-wrap;margin-bottom:20px}
        .dlc-page .dlc-buttons{display:flex;flex-direction:column;gap:10px;max-width:400px;width:100%}
        .dlc-page button{padding:12px 20px;font-size:0.9em;font-family:inherit;border-radius:20px;cursor:pointer;transition:all 0.3s;background:transparent;color:#ddd;border:1px solid #555;text-align:left}
        .dlc-page button:hover{border-color:#cc88ff;color:#cc88ff;box-shadow:0 0 15px rgba(136,68,204,0.3)}
        .dlc-page .dlc-back-btn{position:absolute;top:15px;left:15px;padding:8px 16px;font-size:0.8em;font-family:inherit;border-radius:15px;cursor:pointer;background:transparent;color:#888;border:1px solid #444}
        .dlc-page .dlc-back-btn:hover{color:#fff;border-color:#fff}
        .nickname-row{display:flex;gap:10px;align-items:center;justify-content:center;flex-wrap:wrap;margin:16px 0 8px}
        .nickname-row label{font-size:0.85em;color:#ddd}
        .nickname-input{width:min(320px,100%);padding:10px 12px;border-radius:12px;border:1px solid #555;background:rgba(0,0,0,0.35);color:#fff;font-family:inherit;outline:none}
        .nickname-input:focus{border-color:#cc88ff;box-shadow:0 0 0 2px rgba(204,136,255,0.15)}
        .leaderboard-box{margin-top:14px;text-align:left;background:rgba(0,0,0,0.28);border:1px solid #444;border-radius:14px;padding:12px 14px;max-height:220px;overflow:auto}
        .leaderboard-title{font-weight:bold;color:#ffcc66;margin-bottom:8px}
        .leaderboard-section{margin-top:10px}
        .leaderboard-section h4{font-size:0.85em;color:#ddd;margin:8px 0}
        .leaderboard-list{font-size:0.78em;line-height:1.7;color:#ccc}
        .leaderboard-item{display:flex;justify-content:space-between;gap:8px;border-bottom:1px dashed rgba(255,255,255,0.08);padding:2px 0}
        .leaderboard-item:last-child{border-bottom:none}
        .leaderboard-meta{display:flex;justify-content:space-between;gap:8px;align-items:center}
        .leaderboard-name{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
        .leaderboard-days{flex:0 0 auto;color:#ffdd88}
        .suggestion-box{margin-top:12px;padding:12px;border:1px solid #6d4b2f;border-radius:14px;background:rgba(255,160,60,0.06)}
        .suggestion-box h4{margin:0 0 8px;font-size:0.9em;color:#ffd7a6}
        .suggestion-input{width:100%;min-height:90px;resize:vertical;border-radius:10px;border:1px solid #555;background:rgba(0,0,0,0.35);color:#fff;padding:10px;font-family:inherit;font-size:0.88em;line-height:1.6;outline:none}
        .suggestion-input:focus{border-color:#ffb56b;box-shadow:0 0 0 2px rgba(255,181,107,0.15)}
        .suggestion-actions{display:flex;gap:8px;align-items:center;margin-top:8px;flex-wrap:wrap}
