  map.innerHTML=`
    <div class="ui45-map-head">
      <div>
        <div class="ui45-map-kicker">WORLD // CAMPUS MAP</div>
        <div class="ui45-map-title">🏫 校园地图</div>
      </div>
      <div style="display:flex;align-items:center;gap:6px">
        <div class="ui45-map-day">${window.S?'DAY '+S.day:'DAY --'}</div>
        <button class="ui45-map-toggle" onclick="ui46ToggleMap()">−</button>
      </div>
    </div>
    <div class="ui45-map-canvas">
      <span class="ui46-road a"></span>
      <span class="ui46-road b"></span>
      <span class="ui46-road c"></span>
      <span class="ui46-road d"></span>
      <span class="ui46-road e"></span>
      <span class="ui46-road f"></span>
      <span class="ui46-road g"></span>
      ${nodes}
    </div>
    <div class="ui45-map-footer">
      <div class="ui45-map-current">当前：${UI46_MAP_NODES[current]?.name||'未知地点'}</div>
      <div style="display:flex;gap:5px">
        <button class="ui45-map-btn" onclick="openFaction45()">势力</button>
        <button class="ui45-map-btn" onclick="ui46FitMap()">整理</button>
      </div>
    </div>`;
}

function ui46FitMap(){
  const map=document.getElementById('ui45Map');
  if(!map)return;
  map.classList.remove('collapsed');
}

function ui46Refresh(){
  renderMap46();

  /* 窄屏默认收起，避免地图挡住行动区 */
  if(window.innerWidth<1000){
    const map=document.getElementById('ui45Map');
    if(map) map.classList.add('collapsed','mobile-collapsed');
  }
}

function ui46OpenFactions(){
  const old=document.getElementById('ui45FactionOverlay');
  if(old) old.remove();

  const overlay=document.createElement('div');
  overlay.id='ui45FactionOverlay';
  overlay.className='ui45-faction-overlay';

  overlay.innerHTML=`
    <div class="ui45-faction-window">
      <div class="ui45-faction-head">
        <div>
          <div class="ui45-faction-kicker">SOCIAL // FACTION NETWORK</div>
          <div class="ui45-faction-title">六大势力</div>
          <div class="ui45-faction-sub">势力之间彼此制衡，你的行动会逐步改变关系。</div>
        </div>
        <button class="ui42-close" onclick="document.getElementById('ui45FactionOverlay').remove()">✕</button>
      </div>

      <div class="ui45-faction-grid">
        ${UI46_FACTIONS.map(f=>{
          const pct=Math.max(0,Math.min(100,(f.relation+100)/2));
          return `
          <div class="ui45-faction-card" style="color:${f.color}">
            <div class="ui45-faction-icon">${f.icon}</div>
            <div class="ui45-faction-name">${f.name}</div>
            <div class="ui45-faction-type">${f.type}</div>
            <div class="ui45-faction-desc">${f.desc}</div>
            <div class="ui45-relation">
              <div class="ui45-relation-head">
                <span>当前关系</span>
                <strong style="color:${f.color}">${f.relation>0?'+':''}${f.relation}</strong>
              </div>
              <div class="ui45-relation-track">
                <div class="ui45-relation-fill" style="width:${pct}%;background:${f.color};box-shadow:0 0 12px ${f.color}"></div>
              </div>
            </div>
            <div class="ui45-faction-tags">
              ${f.tags.map(t=>`<span class="ui45-faction-tag">${t}</span>`).join('')}
            </div>
          </div>`;
        }).join('')}
      </div>
    </div>`;
  document.body.appendChild(overlay);
}

/* 覆盖旧势力入口，保留函数名兼容现有按钮 */
window.openFaction45=ui46OpenFactions;

setTimeout(ui46Refresh,120);
window.addEventListener('resize',()=>{
  const map=document.getElementById('ui45Map');
  if(!map)return;
  if(window.innerWidth<1000){
    map.classList.add('collapsed','mobile-collapsed');
  }else{
    map.classList.remove('mobile-collapsed');
  }
});

['dayVal','locVal','timeVal'].forEach(id=>{
  const el=document.getElementById(id);
  if(el)new MutationObserver(ui46Refresh).observe(el,{subtree:true,childList:true,characterData:true});
});
</script>


<style>
