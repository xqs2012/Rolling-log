function useZSY(){
    let cost = S.location==='rooftop' ? 3 : 2;
    if(S.ap<cost||S.gameOver||!S.cards.zsy)return;
    S.ap-=cost;
    
    let baseFail = 0.5;
    if(S.customAccount === 'zsy') baseFail = 0.8;
    if(S.bossMood === 'angry') baseFail -= 0.2;
    
    if(Math.random() < baseFail){
        document.getElementById('storyText').textContent='你正准备大吼召唤校长...';
        document.getElementById('storyFlavor').textContent=cardDefs.zsy.failFlavor;
        addLog(cardDefs.zsy.failLog,'warn');streakCheck(false);
    }else{
        trackHateSystem('zsy');
        let d = Math.floor((S.streak>=2?120:80) * getResilienceFactor());
        if(S.cardUseStreak >= 2){ d = Math.floor(d * 0.7); addLog('🛡️ 滚木适应了你的攻击！伤害-30%','warn'); }
        if(S.buffs.bossConfused){ d = Math.floor(d * 1.15); addLog('🌀 滚木混乱！受到伤害+15%','heal'); }
        if(S.buffs.bodyPassive && S.playerHp < S.maxHp * 0.3) d = Math.floor(d * 1.25);
        consumeCardIfNeeded('zsy');S.cardUses++;
        let actual = applyDamageToBoss(d);
        document.getElementById('storyText').textContent='你大吼一声！校长和德育处赶到！';
        document.getElementById('storyFlavor').textContent=cardDefs.zsy.flavor;
        addLog(`⚖️ ZSY：造成${actual}伤害`,'card');streakCheck(true);
    }
    advanceTime();updateUI();
}

function trackHateSystem(key) {
    if(S.lastCardUsed === key) {
        S.cardUseStreak++;
        S.buffs.bossConfused = false;
    } else {
        if(S.lastCardUsed !== '') {
            S.buffs.bossConfused = true;
        }
        S.cardUseStreak = 1;
    }
    S.lastCardUsed = key;
}

function useCard(key){
    if(!S.cards[key]||S.gameOver)return;
    
    if (key === 'cqy') {
        addLog('✨ CQY特权：使用卡牌不消耗任何AP！', 'card');
    }

    if (key === 'cqy' && S.customAccount === 'cqy') {
        if (Math.random() < 0.8) {
            addLog('💔 CQY分心去偷卷子了！使用卡片失败。', 'warn');
            return;
        }
    }
    
    trackHateSystem(key);
    if(key === 'dzz') S.dzzUses++;
    const d=cardDefs[key];
    let dmg=S.streak>=2?Math.floor(d.dmg*1.5):d.dmg;
    dmg = Math.floor(dmg * getResilienceFactor());
    if(S.cardUseStreak >= 2){ dmg = Math.floor(dmg * 0.7); addLog('🛡️ 滚木适应了你的攻击！变身卡伤害-30%','warn'); }
    if(S.buffs.bossConfused){ dmg = Math.floor(dmg * 1.15); addLog('🌀 滚木混乱中！本次及后续攻击伤害+15%','heal'); }
    if(S.buffs.bodyPassive && S.playerHp < S.maxHp * 0.3) dmg = Math.floor(dmg * 1.25);
    consumeCardIfNeeded(key);S.cardUses++;
    let actual = applyDamageToBoss(dmg);
    document.getElementById('storyText').textContent=`使用变身卡：${d.full}！`;
    document.getElementById('storyFlavor').textContent=d.flavor;
    addLog(d.log.replace(/\d+/,(m)=>actual),'card');
    if(d.onUse)d.onUse();streakCheck(true);updateUI();
}

function useCombo(type){
    const combos={
        'zsy+dzz':{dmg:200,log:'💥 ZSY+DZZ组合技！200伤害！',flavor:'政治法律+物理攻击！校长德育处到场！',consume:['zsy','dzz'],flag:'comboUsed'},
        'zsy+cqy':{dmg:150,log:'📋 行政弹劾！150伤害，愤怒清零！',flavor:'法律+行政联合打击！',consume:['zsy','cqy'],flag:'_comboZsyCqy',extra:()=>{S.angryPeople=0;}},
        'xqs+cqy':{dmg:125,log:'📢 舆论法庭！传播+30%，滚木下回合无法攻击！',flavor:'嘴炮+管理层联合！',consume:['xqs','cqy'],flag:'_comboXqsCqy',extra:()=>{S.spread=Math.min(100,S.spread+30); S.buffs.musicStun=true;}},
        'xqs+dzz':{dmg:140,log:'💪 XQS+DZZ嘴炮物理！140伤害！',flavor:'嘴炮+物理连击！滚木下回合无法行动',consume:['xqs','dzz'],flag:'_comboXqsDzz',extra:()=>{S.buffs.musicStun=true}}
    };
    const c=combos[type];if(!c||S[c.flag])return;
    let dmg=S.streak>=2?Math.floor(c.dmg*1.5):c.dmg;
    dmg = Math.floor(dmg * getResilienceFactor());
    if(S.buffs.bossConfused){ dmg = Math.floor(dmg * 1.15); }
    if(S.buffs.bodyPassive && S.playerHp < S.maxHp * 0.3) dmg = Math.floor(dmg * 1.25);
    S.cardUses++;
    c.consume.forEach(k=>consumeCardIfNeeded(k));S[c.flag]=true;
    let actual = applyDamageToBoss(dmg);
    grantExp(100);
    document.getElementById('storyText').textContent='💥 组合技发动！';
    document.getElementById('storyFlavor').textContent=c.flavor;
    addLog(c.log.replace(/\d+/,(m)=>actual),'card');
    if(c.extra)c.extra();
    if(type==='zsy+dzz')S.angryPeople=0;
    streakCheck(true);updateUI();
}

function continueAttack(){
    let cost = S.location==='rooftop' ? 3 : 2;
    if(S.ap<cost||S.gameOver||!S.isAttacking)return;
    S.ap-=cost;
    S.attackProgress += 25;
    addLog(`⚔️ 反抗进度+25%（${S.attackProgress}%）`);
    if(S.attackProgress >= 100){
        S.isAttacking = false;
        S.attackProgress = 0;
        S.bossResilience = Math.max(0, S.bossResilience - 1);
        addLog('⚔️ 破防成功！削减滚木1层坚韧！','card');
        S.resistPower = Math.min(100, S.resistPower + 10);
        let dmg = Math.floor((15 + S.resistPower * 0.8) * getResilienceFactor());
        if(S.streak >= 2) dmg = Math.floor(dmg * 1.3);
        if(S.buffs.bodyPassive && S.playerHp < S.maxHp * 0.3) dmg = Math.floor(dmg * 1.25);
        let actual = applyDamageToBoss(dmg);
        addLog(`⚔️ 破防突袭造成 ${actual} 点伤害`,'dmg');
        const cdmg = Math.floor(Math.random()*16)+10;
        const fc = S.dzzHpHalved ? Math.floor(cdmg*1.5) : cdmg;
        applyPlayerDamage(fc);
        S.affection += 15;
        updateBossMaxHp();
        addLog(S.invincibleMode ? '💥 滚木打断反抗！但无敌模式免疫反噬' : `💥 滚木打断反抗！-${fc}HP`,'dmg');
        streakCheck(false);
        if(S.playerHp <= 0 && !S.gameOver){
            S.gameOver=true; S.victory=false;
            showOverlay('💀 你被击败...','','lose');
            addLog('💀 游戏结束');
            updateUI();
        }
    } else {
        if(Math.random()<0.4) bossCounter();
        streakCheck(true);
    }
    checkHpThresholds();
    advanceTime();
    updateUI();
}

function moveTo(lk, cost){
    if(S.ap<cost||S.gameOver)return;
    if(S.blockedLocations.includes(lk)){addLog('🚫 该地点已被封锁！','warn');return;}
    S.ap-=cost;
    S.location=lk;
    document.getElementById('storyText').textContent=`你来到了${locations[lk].name}。`;
    addLog(`移动到${locations[lk].name}`);
    let encounterChance = lk === 'hallway' ? 0.5 : 0.25;
    if(lk==='hallway'&&S.targeted&&Math.random()<encounterChance){
        addLog('🚪 走廊被围追堵截！','warn');bossCounter();streakCheck(false);
    }else{
        streakCheck(true);
    }
    musicComboCheck();checkHpThresholds();checkItemDrop();advanceTime();updateUI();
}

function advanceTime(){
    if(S.weatherDay>0){S.weatherDay--;if(S.weatherDay<=0)S.weather='晴天'}
    const used=S.maxAp-S.ap;const nt=Math.min(2,Math.floor(used/2));
    if(nt>S.timeIndex){S.timeIndex=nt;addLog(`⏰ ${S.timeNames[S.timeIndex]}`)}
    
    checkEnrageEvent();
    
    if(S.timeIndex>=2&&!S.gameOver)setTimeout(()=>{if(!S.gameOver&&S.timeIndex>=2)endDay()},400);
}
function updateBlockedLocations(){S.blockedLocations = [];if(S.day > 20 && S.npcStance.teacher === 'hostile') S.blockedLocations.push('office');if(S.day > 35 && S.bossHp < 500) S.blockedLocations.push('classroom');if(S.day > 50) S.blockedLocations.push('rooftop');}

function endDay(){
  if(S.gameOver)return;addLog(`🌙 ${getDateString(S.day)}结束`);
  
  if(S.affection>=30){S.playerHp=Math.min(S.maxHp,S.playerHp+5);addLog('💚 恢复5HP','heal');}else addLog('⚠️ 好感度不足，无法回血','warn');
  if(S.affection>=30){S._healStreak=(S._healStreak||0)+1;if(S._healStreak>=3){S.playerHp=Math.min(S.maxHp,S.playerHp+5);addLog('💚 连续3天好感≥30！额外+5HP','heal');S._healStreak=0}}else S._healStreak=0;
  S.spread=Math.max(0,S.spread-5);
  if(S.buffs.coolPassive){ S.spread=Math.min(100,S.spread+3); addLog('📢 传说之力发散：自动传播+3%','card'); }
  
  S.evidenceValue = Math.max(0, S.evidenceValue - 2);

  if (skillLevel('r5') > 0) {
      S.playerHp = Math.min(S.maxHp, S.playerHp + 15);
      addLog('🧘 每日静思生效：恢复 15 HP', 'heal');
  }
  
  if (S.bossHp > 0) {
      if (S.noRegen) {
          addLog('⚠️ 滚木已被永久禁疗，今晚无法回血！', 'heal');
      } else if (S.healStun > 0) {
          S.healStun--;
          addLog('⚠️ 滚木仍处于错愕/幻听禁疗状态，今晚无法回血！', 'heal');
      } else {
          if (S.invincibleMode) {
              addLog('⭐ 无敌模式：滚木无法回血','heal');
          } else {
              let bh = Math.floor(S.bossMaxHp * 0.12);
              if (S.chargingHeal) {
                  bh = Math.floor(S.bossMaxHp * 0.20);
                  addLog('⚠️ 蓄力完成！滚木获得强化夜间回复，恢复了额外生命。', 'warn');
                  S.chargingHeal = false;
                  S.healChargeCooldown = 5;
              }
              if(S.bossRegenBoost) { bh *= 2; addLog('⚠️ 滚木受到歌声刺激，夜间恢复量翻倍！', 'warn'); }
              if (S.bossHp < S.bossMaxHp * 0.3) {
                  bh += Math.floor(Math.random()*21)+20;
                  addLog('💢滚木暴怒，额外大幅回血','warn');
              }
              if (S.mockeryMark) {
                  bh += 150;
                  addLog('🦇 滚木通过讥笑吸取了你的负面情绪！额外大幅恢复！', 'warn');
              }
              S.bossHp = Math.min(S.bossMaxHp, S.bossHp + bh);
              addLog(`🌙 夜幕降临，滚木销毁不利证据，恢复了 ${bh} HP，层数清零！`, 'warn');
          }
      }
      S.bossLayers = 0;
  }
  
  S.bossRegenBoost = false;

  if ((S.healChargeCooldown || 0) > 0) {
      S.healChargeCooldown--;
  }

  const canCharge =
      S.bossHp > 0 &&
      !S.chargingHeal &&
      (S.healChargeCount || 0) < (S.healChargeMax || 3) &&
      (S.healChargeCooldown || 0) <= 0 &&
      S.day >= 6 &&
      S.bossHp < S.bossMaxHp * 0.85;

  if (canCharge && Math.random() < 0.18) {
      S.chargingHeal = true;
      S.healChargeCount = (S.healChargeCount || 0) + 1;
      addLog(`⚠️ 【异常蓄力 ${S.healChargeCount}/${S.healChargeMax}】滚木准备在下一夜进行强化回血。`, 'warn');
  }

  if (S.day % 10 === 0 && S.day > 0) {
      S.bossResilience++;
      addLog('🛡️滚木变得更加坚韧！防御增强','warn');
  }
  
  const rMood = Math.random();
  if(rMood < 0.33) S.bossMood = 'happy';
  else if(rMood < 0.66) S.bossMood = 'angry';
  else S.bossMood = 'normal';
  S.moodKnown = S.buffs.intPassive; 
  if(S.moodKnown) addLog('🧠 洞察力启动：已预知明日滚木心情！','heal');

  if(S.affection >= 30 && Math.random() < 0.3 && S.items.length < S.maxItems && !S.items.includes('bandaid')) {
      S.items.push('bandaid');
      addLog('💊 滚木心情不错，你捡到了一个创可贴！','heal');
  }
  if(S.affection >= 60 && Math.random() < 0.5 && S.items.length < S.maxItems && !S.items.includes('bandaid')) {
      S.items.push('bandaid');
      addLog('💊 滚木心情愉悦，又捡到一个创可贴！','heal');
  }

  S.pressure = Math.max(0, S.pressure - 5);if(S.pressure >= 80) addLog('😰 压力过高，你做了一个噩梦...', 'warn');
  if(S.day > 15 && S.affection < -20) S.npcStance.teacher = 'hostile';if(S.spread > 50) S.npcStance.students = 'supportive';
  S.isAttacking=false;S.attackProgress=0;S.streak=0;S.musicCombo=0;
  S.buffs={ bossConfused: false, bodyPassive: S.buffs.bodyPassive, intPassive: S.buffs.intPassive, coolPassive: S.buffs.coolPassive };
  const sp=getSpecialDay(S.day);if(sp){sp.eff();addLog(`📅 ${sp.name}：${sp.desc}`,'card')}
  if(S.day%4===0)randomEvent();
  if(S.playerHp<50&&S.day>10) applyDamageToBoss(20);
  if (S.parentCallCooldown > 0) S.parentCallCooldown--;
  S.day++;S.ap=S.maxAp;S.timeIndex=0;S.course=courses[S.day%7]?courses[S.day%7][0]:'无课';S.courseEffect=courses[S.day%7]?courses[S.day%7][1]:'';S.weather=getWeather(S.day);
  updateBossMaxHp();
  
  checkEnrageEvent();
  
  document.getElementById('storyText').textContent=`${getDateString(S.day)}。${S.course}（${S.courseEffect}）`;
  document.getElementById('storyFlavor').textContent='';
  if(S.day > MAX_DAYS && !S.gameOver){S.gameOver = true; S.victory = false;showOverlay('⏰ 时间耗尽', `两个月期限已到，你未能揭露滚木的所有恶行。\n滚木继续在学校里逍遥法外...`, 'lose');addLog('⏰ 两个月期限已到，游戏结束');}
  S.dailyTasks.forEach((t,i) => { if(!S.dailyTaskDone[i] && t.check()){ S.dailyTaskDone[i] = true; t.reward(); addLog('📜 每日任务完成！','card'); }});
  S.dailyFoundCount = 0; S.rainLoveCount = 0; refreshDailyTasks(); saveSkillData(); updateUI();
}

function addLog(msg,type=''){const c=document.getElementById('logContainer');const e=document.createElement('div');e.className='log-entry '+type;e.innerHTML=`<span class="tg">[${getDateString(S.day)}]</span> ${msg}`;c.insertBefore(e,c.firstChild);while(c.children.length>50)c.removeChild(c.lastChild);showToast(msg);}
function checkGameOver(){if(S.gameOver)return;if(S.bossHp<=0&&!S.endingChosen){S.gameOver=true;S.victory=true;triggerEndingSelection();}else if(S.playerHp<=0){S.gameOver=true;S.victory=false;showOverlay('💀 你被击败...','','lose');addLog('💀 游戏结束');}else if(S.affection>=100){S.gameOver=true;S.victory=false;showOverlay('🎭 歌剧魅影','好感度100%...','lose');}if(S.gameOver&&S.bossHp>0)updateUI();}
function showOverlay(title,text,type){document.getElementById('overlayTitle').textContent=title;document.getElementById('overlayText').textContent=text;document.getElementById('overlayBox').className='overlay-box '+type;document.getElementById('overlayStats').innerHTML=S.victory?getStats().join('<br>'):'';const q=document.getElementById('loseQuote');const lb=document.getElementById('leaderboardBox');if(type==='lose'){q.textContent='你完蛋了，放学别走，车棚见，我带兄弟来砍你。';q.style.display='block';if(lb){lb.style.display='none';lb.innerHTML='';}}else{q.style.display='none';if(type==='win'){renderRankings('leaderboardBox', true);}else if(lb){lb.style.display='none';lb.innerHTML='';}}document.getElementById('overlay').style.display='flex';}
function triggerEndingSelection(){
  document.getElementById('endingOverlay').style.display = 'flex';
  document.getElementById('endingBox').innerHTML = `<h1>滚木已经输了。</h1><p style="color:#ccc;margin:15px 0;">真正的选择，现在才开始。</p><button class="ending-choice-btn" onclick="showEnding(1)">【结束这一切】</button><button class="ending-choice-btn" onclick="showEnding(2)">【交给他们】</button><button class="ending-choice-btn" onclick="showEnding(3)">【坐下】</button>`;
}
function showEnding(type){
  S.endingChosen = true;S.endingType = type === 1 ? 'judgement' : type === 2 ? 'silence' : 'inheritance';localStorage.setItem('rollwood_ending', S.endingType);
  const box = document.getElementById('endingBox');
  if(type === 1){box.innerHTML = `<h1 style="color:#ffaa00;">Ending I：审判（Judgement）</h1><div class="ending-text">滚木倒下。<br>学校恢复平静。<br>一年以后。<br>欺凌消失。<br>没有人再提起滚木。<br><br><i>"有时候，审判必须由受害者亲自执行。"</i></div><button class="ending-choice-btn" onclick="finishGame()">返回标题</button>`;}
  else if(type === 2){box.innerHTML = `<h1 style="color:#88ccff;">Ending II：沉默（Silence）</h1><div class="ending-text">滚木被带走。<br>官方发布通报，宣称一切问题已解决。<br>但你发现，新的"滚木"正在角落里悄悄出现...<br><br><i>"除掉一个恶人，除不掉产生恶人的土壤。"</i></div><button class="ending-choice-btn" onclick="finishGame()">返回标题</button>`;}
  else {box.innerHTML = `<h1 style="color:#ff4444;">Ending III：继承（Inheritance）</h1><div class="ending-text">你看着滚木曾经的位置。<br>你坐了下去。<br>所有的学生都用恐惧的眼神看着你。<br>你笑了。<br><br><i>"凝视深渊过久，深渊将回以凝视。"</i></div><button class="ending-choice-btn" onclick="finishGame()">返回标题</button>`;}
}
function finishGame(){
  recordWinRankings();
  document.getElementById('endingOverlay').style.display='none';
  showOverlay('🎉 胜利！','','win');
}
function refreshDailyTasks(){
  S.dailyTasks = [{desc:'进行1次暗中观察',check:()=>S.buffs.observeBuff,reward:()=>{grantExp(20)}}, {desc:'造成100点伤害',check:()=>S.totalDmg>=100,reward:()=>{S.ap=Math.min(S.maxAp,S.ap+1)}}, {desc:'存活且不被发现',check:()=>S.dailyFoundCount===0&&S.timeIndex>=2,reward:()=>{grantExp(30)}}];
  S.dailyTaskDone = [false,false,false];
}
function checkMainQuest(){if(S.mainQuestStage===1&&S.spread>=30){S.mainQuestStage++;S.ap=S.maxAp;addLog('📜 主线推进：需要报告德育处2次','card')}else if(S.mainQuestStage===3&&S.bossHp<=800){S.mainQuestStage++;S.playerHp=S.maxHp;addLog('📜 主线推进：滚木进入二阶段！','warn')}}
function advanceMainQuest(){S.mainQuestStage++;addLog('📜 主线达成！全属性提升','card');S.permanentBonuses.dmgBonus+=10;S.permanentBonuses.maxHpBonus+=20;S.maxHp+=20;}

function triggerSy(){S.sideQuestFlags.sy=true;S.permanentBonuses.spreadBonus+=20;S.permanentBonuses.dmgBonus+=10;addLog('🚨sy带你加入信息帮！');S.targeted=true;bossCounter();}
function triggerLsy(){S.sideQuestFlags.lsy=true;S.maxHp+=30;S.playerHp=Math.min(S.maxHp,S.playerHp+30);S.spread=Math.min(100,S.spread+5);S.attributePoint+=2;S.skillPoint+=2;
    if(S.items.length < S.maxItems) S.items.push('bandaid');
    if(S.items.length < S.maxItems) S.items.push('bandaid');
    addLog('📚学霸团加入！赠送2个创可贴');}
function triggerZqt(){S.sideQuestFlags.zqt=true;S.bossHp=Math.max(0,S.bossHp-200);S.totalDmg+=200;S.spread=Math.min(100,S.spread+10);if(!S.cards.zsy)S.cards.zsy=true;
    if(S.items.length < S.maxItems) S.items.push('bandaid');
    addLog('👩‍🏫zqt老师赋予权限！并送了创可贴');}
function triggerFbq(){S.sideQuestFlags.fbq=true;S.targeted=false;S.nailongBuff=2;
    if(S.items.length < S.maxItems) S.items.push('bandaid');
    addLog('🎤fbq帮你吓退滚木！并给了创可贴');}

document.getElementById('openSkillBtn').onclick = openSkillTree;
document.getElementById('closeSkillBtn').onclick = closeSkillTree;
document.getElementById('endDayBtn').onclick = () => { if(!S.gameOver) { S.ap=0; advanceTime(); } };
document.getElementById('openTaskBtn').onclick = () => {
    document.getElementById('taskOverlay').style.display = 'flex';
    document.getElementById('taskContent').innerHTML = `<h3>📜 每日任务</h3>` + S.dailyTasks.map((t,i) => `<div class="task-item"><span>${t.desc}</span><span class="${S.dailyTaskDone[i]?'task-reward':'task-progress'}">${S.dailyTaskDone[i]?'已完成':'进行中'}</span></div>`).join('') + `<br><h3>📌 主线阶段 ${S.mainQuestStage}</h3><p style="font-size:0.8em;color:#aaa;">${S.mainQuestStage===1?'让传播度达到30%':S.mainQuestStage===2?'在教务处报告德育处2次（进度：'+S.reportCount+'/2）':S.mainQuestStage===3?'将滚木的HP削减至800以下':'揭露所有恶行，准备最终决战'}</p><button onclick="document.getElementById('taskOverlay').style.display='none'" style="margin-top:15px;padding:8px 12px;width:100%;background:#333;color:#fff;border:none;border-radius:8px;cursor:pointer;">关闭</button>`;
};
document.getElementById('restartBtn').onclick = () => location.reload();
document.addEventListener('keydown', (e) => {
    if(S.gameOver||document.getElementById('skillOverlay').style.display==='flex'||document.getElementById('taskOverlay').style.display==='flex'||document.getElementById('dlcPage').style.display==='flex'||document.getElementById('rulesPage').style.display==='flex')return;
    if(e.key>='1'&&e.key<='4'){
        const btns = document.querySelectorAll('#actionsGrid .action-btn:not(:disabled)');
        const idx = parseInt(e.key)-1; if(btns[idx]) btns[idx].click();
    }
    if(e.key.toLowerCase()==='e') document.getElementById('endDayBtn').click();
    if(e.key.toLowerCase()==='z') useZSY();
});

async function init() {
    refreshDailyTasks();
    loadSkillData();
    updateBossMaxHp();
    updateUI();
    await renderRankings('startLeaderboardBox', false);
}
init();
</script>

