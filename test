function submitCode() {
    const code = document.getElementById('codeInput').value.trim().toUpperCase();
    if (code === 'YDHFMAP') {
        S.chargingHeal = false;
        S.healStun = 1;
        S.healChargeCooldown = Math.max(S.healChargeCooldown || 0, 4);
        applyDamageToBoss(200);
        addLog('🔊 严重幻听引发反噬！滚木自残 200 HP，本次蓄力被打断，并进入4天冷却。', 'heal');
