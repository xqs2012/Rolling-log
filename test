  document.getElementById('dlcPage').style.display = 'none';
  document.getElementById('rulesPage').style.display = 'flex';
  renderRankings('startLeaderboardBox', false);
}

function renderDLCScene() {
  const ch = DLC.chapters[DLC.chapter];
  if (!ch || DLC.scene >= ch.scenes.length) {
    if (DLC.chapter < DLC.chapters.length - 1) {
      DLC.chapter++;
      DLC.scene = 0;
      renderDLCScene();
      return;
    } else {
      closeDLC();
      return;
    }
  }
  const sc = ch.scenes[DLC.scene];
  document.getElementById('dlcChapterName').textContent = ch.name;
  document.getElementById('dlcContent').innerHTML = sc.text.replace(/\n/g, '<br>');
  
  const buttonsDiv = document.getElementById('dlcButtons');
  buttonsDiv.innerHTML = '';
  
  if (sc.choices) {
    sc.choices.forEach(c => {
      const btn = document.createElement('button');
      btn.textContent = c.text;
      btn.onclick = function() {
        if (c.nextChapter !== undefined) {
          DLC.chapter = c.nextChapter;
          DLC.scene = c.nextScene;
        } else {
          DLC.scene++;
        }
        renderDLCScene();
      };
      buttonsDiv.appendChild(btn);
    });
  } else {
    const continueBtn = document.createElement('button');
    continueBtn.textContent = '继续 ▸';
    continueBtn.onclick = function() {
      DLC.scene++;
      renderDLCScene();
    };
    buttonsDiv.appendChild(continueBtn);
  }
}

