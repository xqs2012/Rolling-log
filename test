<script>
/* =========================================================
 UI 4.7 支线任务数据层
 不替换原有支线触发逻辑；仅把已有 sideQuestFlags / sideQuestAttempts
 正式呈现出来。
========================================================= */

const UI47_SIDE_QUESTS = [
  {
    id:'sy',
    icon:'💾',
    name:'信息帮的第一份情报',
    type:'情报线',
    faction:'信息帮',
    color:'#68b8ff',
    desc:'协助信息帮完成第一轮校园情报传播，建立稳定的线索渠道。',
    objective:'触发信息帮支线',
    reward:'传播强化 + 伤害强化',
    source:'sy'
  },
  {
    id:'lsy',
    icon:'📚',
    name:'学霸团的援手',
    type:'支援线',
    faction:'学生会',
    color:'#7ee0a3',
    desc:'与学生中的核心学习群体建立联系，获得长期资源支援。',
    objective:'触发学霸团支线',
    reward:'最大HP +30、属性点 +2、技能点 +2',
    source:'lsy'
  },
  {
    id:'zqt',
    icon:'👩‍🏫',
    name:'教师权限',
    type:'管理线',
    faction:'管理层',
    color:'#c8baff',
    desc:'获得教师层面的临时权限，直接对滚木造成规则伤害。',
    objective:'触发教师权限支线',
    reward:'Boss -200 HP、解锁 ZSY、获得道具',
    source:'zqt'
  },
  {
    id:'fbq',
    icon:'🎤',
    name:'音乐干预',
    type:'特殊线',
    faction:'音乐事件',
    color:'#d58bff',
    desc:'利用音乐事件制造特殊干扰，让滚木暂时失去攻击目标。',
    objective:'触发音乐相关支线',
    reward:'取消被锁定、获得特殊状态与道具',
    source:'fbq'
  }
];

const UI47_FACTION_COLORS={
  '信息帮':'#68b8ff',
  '学生会':'#7ee0a3',
  '管理层':'#c8baff',
  '音乐事件':'#d58bff',
  '数学帮':'#ffd36a',
  '滚木帮':'#ff5c67',
  '级风会':'#ff9b62'
};

function ui47QuestState(q){
  const flag=!!(window.S && S.sideQuestFlags && S.sideQuestFlags[q.id]);
  if(flag) return {state:'done',label:'已完成',pct:100};

  const attempts=window.S && S.sideQuestAttempts ? Number(S.sideQuestAttempts[q.id]||0):0;
  if(attempts>0) return {state:'active',label:`调查中 · ${attempts}次尝试`,pct:Math.min(85,20+attempts*10)};

  return {state:'pending',label:'未触发',pct:0};
}

function ui47RenderSideQuests(box){
  const completed=UI47_SIDE_QUESTS.filter(q=>ui47QuestState(q).state==='done').length;

  box.innerHTML=`
    <div class="ui42-section-head">
      <div class="ui42-section-title">◇ 支线任务</div>
      <div class="ui42-section-badge">${completed}/${UI47_SIDE_QUESTS.length} COMPLETED</div>
    </div>

    <div style="color:#85879a;font-size:.64em;line-height:1.5;margin-bottom:9px">
      支线不会取代主线；它们负责建立势力关系、提供额外成长，并可能改变后续事件。
    </div>

    ${UI47_SIDE_QUESTS.map(q=>{
      const s=ui47QuestState(q);
      const fc=UI47_FACTION_COLORS[q.faction]||q.color;
      return `
      <div class="ui47-side-card ${s.state==='done'?'completed':''}">
        <div class="ui47-side-top">
          <div class="ui47-side-icon">${q.icon}</div>
          <div class="ui47-side-main">
            <div class="ui47-side-name">${q.name}</div>
            <div class="ui47-side-type">${q.type}</div>
          </div>
          <div class="ui47-side-status ${s.state==='done'?'done':s.state==='active'?'active':'lock'}">
            ${s.label}
          </div>
        </div>

        <div class="ui47-side-desc">${q.desc}</div>

        <div style="margin-top:8px;color:#a3a5b8;font-size:.61em">
          目标：${q.objective}
        </div>

        <div class="ui47-side-progress">
          <span style="width:${s.pct}%;background:${s.state==='done'?'#7ee0a3':q.color}"></span>
        </div>

        <div class="ui47-side-footer">
          <div class="ui47-faction-rel">
            <span class="ui47-faction-dot" style="background:${fc};box-shadow:0 0 8px ${fc}"></span>
            ${q.faction}
          </div>
          <div style="display:flex;gap:5px">
            <span class="ui47-chip reward">奖励：${q.reward}</span>
          </div>
        </div>
      </div>`;
    }).join('')}
  `;
}

function ui47BuildTasks(){
  const box=document.getElementById('taskContent');
  if(!box)return;

  const tasks=Array.isArray(S.dailyTasks)?S.dailyTasks:[];
  const done=Array.isArray(S.dailyTaskDone)?S.dailyTaskDone:[];
  const stage=S.mainQuestStage||1;

  const questText =
    stage===1?'让传播度达到30%':
    stage===2?`在教务处报告德育处2次（进度：${S.reportCount||0}/2）`:
    stage===3?'将滚木的HP削减至800以下':
    '揭露所有恶行，准备最终决战';

  const questPct=Math.min(100,stage>=4?100:Math.max(15,stage*25));
  const completedDaily=done.filter(Boolean).length;

  const dailyHtml=tasks.length ? tasks.map((t,i)=>{
    const isDone=!!done[i];
    return `
    <div class="ui42-task-item ${isDone?'done':''}">
      <div class="ui42-task-icon">${isDone?'✓':'◇'}</div>
      <div class="ui42-task-desc">${t.desc}</div>
      <div>
        <div class="ui42-task-reward">${isDone?'REWARD CLAIMED':'DAILY OBJECTIVE'}</div>
        <span class="ui42-status ${isDone?'done':'pending'}">${isDone?'已完成':'进行中'}</span>
      </div>
    </div>`;
  }).join('') : '<div class="ui42-task-desc">今日暂无任务。</div>';

  box.innerHTML=`
    <div class="ui42-window-head">
      <div>
        <div class="ui42-kicker">MISSION // QUEST NETWORK</div>
        <div class="ui42-window-title">📜 任务终端</div>
        <div class="ui42-window-sub">主线、支线、每日目标与势力关系。</div>
      </div>
      <button class="ui42-close" onclick="document.getElementById('taskOverlay').style.display='none'">✕</button>
    </div>

    <div class="ui47-quest-summary">
      <div class="ui47-qstat"><div class="ui47-qstat-label">MAIN STAGE</div><div class="ui47-qstat-value">${stage}/4</div></div>
      <div class="ui47-qstat"><div class="ui47-qstat-label">DAILY</div><div class="ui47-qstat-value">${completedDaily}/${tasks.length}</div></div>
      <div class="ui47-qstat"><div class="ui47-qstat-label">SIDE QUEST</div><div class="ui47-qstat-value">${UI47_SIDE_QUESTS.filter(q=>S.sideQuestFlags[q.id]).length}/${UI47_SIDE_QUESTS.length}</div></div>
      <div class="ui47-qstat"><div class="ui47-qstat-label">FACTION LINKS</div><div class="ui47-qstat-value">${Math.min(6,1+(S.sideQuestsTriggered||0))}/6</div></div>
    </div>

    <div class="ui47-quest-tabs">
      <button class="ui47-quest-tab active" data-tab="all">全部任务</button>
      <button class="ui47-quest-tab" data-tab="main">主线</button>
      <button class="ui47-quest-tab" data-tab="side">支线</button>
      <button class="ui47-quest-tab" data-tab="daily">每日</button>
    </div>

    <div id="ui47TaskAll">
      <section class="ui42-task-section">
        <div class="ui42-section-head">
          <div class="ui42-section-title">◆ 主线任务</div>
          <div class="ui42-section-badge">STAGE ${stage}/4</div>
        </div>
        <div class="ui42-quest-main">
          <div class="ui42-quest-number">${stage}</div>
          <div>
            <div class="ui42-task-desc" style="font-size:.84em">${questText}</div>
            <div class="ui42-quest-progress"><span style="width:${questPct}%"></span></div>
          </div>
        </div>
      </section>

      <section class="ui42-task-section">
        <div id="ui47SideQuestBox"></div>
      </section>

      <section class="ui42-task-section">
        <div class="ui42-section-head">
          <div class="ui42-section-title">◈ 每日任务</div>
          <div class="ui42-section-badge">${completedDaily}/${tasks.length} COMPLETED</div>
        </div>
        ${dailyHtml}
      </section>
    </div>
  `;

  ui47RenderSideQuests(document.getElementById('ui47SideQuestBox'));

  box.querySelectorAll('.ui47-quest-tab').forEach(tab=>{
    tab.onclick=()=>{
      box.querySelectorAll('.ui47-quest-tab').forEach(x=>x.classList.remove('active'));
      tab.classList.add('active');

      const type=tab.dataset.tab;
      const sections=box.querySelectorAll('#ui47TaskAll > .ui42-task-section');
      sections.forEach((section,i)=>{
        section.style.display=
          type==='all' ? '':
          type==='main' ? (i===0?'':'none'):
          type==='side' ? (i===1?'':'none'):
          (i===2?'':'none');
      });
    };
  });
}

/* 覆盖上一版 buildTaskUI，让打开任务时直接显示支线 */
window.buildTaskUI=ui47BuildTasks;

setTimeout(()=>{
  const taskBtn=document.getElementById('openTaskBtn');
  if(taskBtn){
    taskBtn.onclick=()=>{
      const overlay=document.getElementById('taskOverlay');
      if(overlay) overlay.style.display='flex';
      ui47BuildTasks();
    };
  }
},30);
</script>

