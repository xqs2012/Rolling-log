function skillLevel(id){ return S.skills[id]||0; }
function skillTreeKeyById(id){ for(const k in skillTreeData) if(skillTreeData[k].perks.some(p=>p.id===id)) return k; return null; }
function getSkillById(id){ for(const k in skillTreeData){ const s=skillTreeData[k].perks.find(p=>p.id===id); if(s) return s; } return null; }
function canLearnSkill(skill){ 
    const lv=skillLevel(skill.id); 
    if(lv>=skill.max) return false; 
    if(S.skillPoint<=0) return false; 
    const key=skillTreeKeyById(skill.id); 
    if(S.attributes[key] < skill.req) return false; 
    if(skill.id === 'b1' && skillLevel('i1') > 0) return false;
    if(skill.id === 'i1' && skillLevel('b1') > 0) return false;
    if(skill.id === 'b8' && S.dzzUses < 5) return false;
    if(skill.id === 'r3' && S.sideQuestsTriggered < 3) return false;
    return true; 
}
