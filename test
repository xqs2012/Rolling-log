        updateUI();
    } else {
        addLog('❌ 指令无效：没有打断本次蓄力。', 'warn');
    }
}

function getResilienceFactor() {
    return Math.max(0.1, 1 - S.bossResilience * 0.03);
}

function executeEvent(ev, cost){
  if(S.ap<cost||S.gameOver)return;
  S.ap-=cost;
  let mult=1;
  if(S.course==='语文课'&&ev.id==='expose')mult=1.2;
  if(S.course==='班会课'&&ev.id==='expose')mult=2;
  if(S.location==='classroom'&&ev.id==='expose')mult*=1.2;
  if(S.day===12)mult*=2;
  if(S.streak>=2)mult*=1.5;
  if(S.buffs.observeBuff){mult*=1.2;S.buffs.observeBuff=false}
  if(S.buffs.thinkBuff){mult*=1.3;S.buffs.thinkBuff=false}
  if(S.buffs.bodyPassive && S.playerHp < S.maxHp * 0.3) mult *= 1.25;
  if(ev.id==='report'&&S.bossLearning.report>=2) mult *= 0.7;
  if(ev.id==='spread2'&&S.bossLearning.spread>=3) mult *= 0.8;
  if(S.pressure >= 70) mult *= 0.85;
  if(S.pressure >= 90) mult *= 0.7;
  const found=checkFound(ev.found||25);
  if(found){addLog('👁️ 被滚木发现了！','warn');bossCounter();streakCheck(false)}
  else streakCheck(true);
  if(ev.eff.aff){S.affection+=Math.floor(ev.eff.aff*mult);updateBossMaxHp();}
  if(ev.eff.angry)S.angryPeople+=ev.eff.angry;
  if(ev.eff.targeted!==undefined)S.targeted=ev.eff.targeted;
  if(ev.eff.nailong)S.nailongBuff=ev.eff.nailong;
  if(ev.eff.spread){S.spread=Math.min(100,S.spread+Math.floor(ev.eff.spread*mult*(1+S.permanentBonuses.spreadBonus/100)));S.bossLearning.spread=(S.bossLearning.spread||0)+1;}
  if(ev.eff.bossDmg){
      const d=Math.floor(ev.eff.bossDmg*mult*(1+S.permanentBonuses.dmgBonus/100) * getResilienceFactor());
      applyDamageToBoss(d);
  }
  if(ev.eff.atkProg){S.isAttacking=true;S.attackProgress=Math.min(100,S.attackProgress+Math.floor(ev.eff.atkProg*mult));S.bossLearning.resist=(S.bossLearning.resist||0)+1;}
  if(ev.onUse)ev.onUse();
  if(S.location==='classroom'&&ev.id==='study'&&!S.hiddenEventFound&&S.day%5===0){
      S.hiddenEventStep++;
      if(S.hiddenEventStep===1) addLog('📄 你在课本里发现了一张旧纸条...');
      else if(S.hiddenEventStep===2) addLog('📄 纸条背面写着半个日期...');
      else if(S.hiddenEventStep===3){
          S.hiddenEventFound=true;S.skillPoint+=3;
          grantExp(30);
          addLog('🔍 你拼凑出了隐藏的真相！获得3SP和30EXP');
      }
  }
  document.getElementById('storyText').textContent=ev.desc;
  if(ev.eff.log)addLog((S.streak>=2?'🔥 ':'')+ev.eff.log,found?'warn':'');
  if(S.spread>=100){
      const spreadDmg=Math.floor(60 * getResilienceFactor());
      let actual = applyDamageToBoss(spreadDmg);
      S.spread=0;
      addLog('📢 恶行传遍全校！造成'+actual+'点伤害','card');
  }
  if(S.buffs.musicStun){S.buffs.musicStun=false}
  else if(!found&&S.bossHp>0&&S.targeted&&!S.buffs.amulet&&!S.buffs.dududuShield)bossCounter();
  if(S.nailongBuff>0){S.nailongBuff--;if(S.nailongBuff<=0){S.targeted=true;addLog('⚠ 奶龙效果消失','warn')}}
  if(S.buffs.studyBuff>0)S.buffs.studyBuff--;
  if(S.buffs.parentProtect>0){S.buffs.parentProtect--;if(S.buffs.parentProtect<=0){S.targeted=true}}
  if(S._aff60penalty>0){S._aff60penalty--;if(S._aff60penalty<=0){S.maxAp=Math.min(6,S.maxAp+1);addLog('📋 告状惩罚结束，AP恢复','heal')}}
  musicComboCheck();checkHpThresholds();checkItemDrop();checkAffEvent();
  checkMainQuest();updateBlockedLocations();advanceTime();updateUI();
}

function checkEnrageEvent() {
    if (S.affection < 0 && S.angryPeople >= 5 && S.course === '数学课' && !S.enrageTriggered) {
        S.enrageTriggered = true;
        document.getElementById('enrageOverlay').style.display = 'flex';
    }
}

