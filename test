                'Content-Type': 'application/json',
                'X-Master-Key': JSONBIN_API_KEY || '$2b$10$YQ...' 
            },
            body: JSON.stringify(data)
        });
        if (res.ok) {
            console.log('排行榜已同步到云端');
            return true;
        }
    } catch (e) {
        console.warn('云端同步失败，使用本地数据', e);
    }
    return false;
}

async function loadLeaderboardFromCloud() {
    if (!JSONBIN_BIN_ID) return null;
    try {
        const url = `https://api.jsonbin.io/v3/b/${JSONBIN_BIN_ID}/latest`;
        const res = await fetch(url, {
            headers: {
                'X-Master-Key': JSONBIN_API_KEY || '$2b$10$YQ...'
            }
        });
        if (res.ok) {
            const json = await res.json();
            return json.record;
        }
    } catch (e) {
        console.warn('从云端加载排行榜失败', e);
    }
    return null;
}

async function renderGlobalLeaderboard(boxId, withSuggestion = false) {
    const box = document.getElementById(boxId);
    if (!box) return;

    let data = normalizeRankings(loadRankings());
    const cloudData = await loadLeaderboardFromCloud();
    if (cloudData) {
        const merged = {
            fastest: dedupeAndSortRanking(
                [...(cloudData.fastest || []), ...(loadRankings().fastest || [])],
                'fastest'
            ),
            through: dedupeAndSortRanking(
                [...(cloudData.through || []), ...(loadRankings().through || [])],
                'through'
            )
        };
        data = normalizeRankings(merged);
        saveRankings(data);
    }

    renderRankingsContent(box, data, withSuggestion);
}

