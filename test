function applyPlayerDamage(dmg, source=''){
    if(S.invincibleMode || dmg <= 0){
        if(source) addLog(`⭐ 无敌模式：${source}伤害无效`,'heal');
        return 0;
    }
    if(S.zqtShields > 0) {
        if(S.playerHp - dmg <= 0) {
            S.zqtShields--;
            addLog(`🛡️ 银黑军团护盾抵挡了致命一击！(剩余 ${S.zqtShields} 次)`,'heal');
            return 0;
        }
    }
    S.playerHp = Math.max(0, S.playerHp - dmg);
    S.totalTaken += dmg;
    return dmg;
}

function applyDamageToBoss(rawDamage) {
    if (S.bossHp <= 0 || S.gameOver) return 0;
    let damage = rawDamage;
    let bossLayers = S.bossLayers || 0; 
    let reduction = Math.min(0.75, bossLayers * 0.15);
    damage = damage * (1 - reduction);
    let damageCap = S.bossMaxHp * 0.1;
    if (damage > damageCap) {
        damage = damageCap;
        addLog('👹 “校规庇护”生效：无视了超出上限的高额伤害！', 'warn');
    }
    let nextHp = S.bossHp - damage;
    if (S.bossHp > S.bossMaxHp * 0.7 && nextHp <= S.bossMaxHp * 0.7) {
        damage = S.bossHp - S.bossMaxHp * 0.7;
        addLog('👹 滚木进入【阶段2：规则重塑】，后续伤害强行免疫！', 'warn');
    } 
    else if (S.bossHp > S.bossMaxHp * 0.3 && nextHp <= S.bossMaxHp * 0.3) {
        damage = S.bossHp - S.bossMaxHp * 0.3;
        addLog('👹 滚木进入【阶段3：困兽犹斗】，绝对防御开启！', 'warn');
    }
    if (bossLayers > 0 && bossLayers % 2 === 0) {
        let rebound = Math.floor(damage * 0.25);
        if(rebound > 0) {
            S.playerHp = Math.max(1, S.playerHp - rebound); 
            addLog(`💥 触发规则反噬！受到 ${rebound} 点精神反弹伤害！`, 'warn');
            if(S.playerHp <= 1 && !S.gameOver){
                addLog('⚠️ 警告：精神崩溃边缘，再受伤害即刻死亡！', 'warn');
            }
        }
    }
    damage = Math.floor(damage);
    if (damage > 0) {
        S.bossHp = Math.max(0, S.bossHp - damage);
        S.totalDmg += damage;
        grantExp(damage);
    }
    if (Math.random() < 0.5) {
        S.bossLayers = (S.bossLayers || 0) + 1;
        addLog(`👹 滚木的执念加深！（当前层数: ${S.bossLayers}）`, 'warn');
    }
    return damage;
}

