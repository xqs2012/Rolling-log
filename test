<script>
/* =========================================================
   UI 4.1 动态视觉状态
========================================================= */
(function(){
    function refreshWorldState(){
        const bossText=document.getElementById('bossHpText')?.textContent||'';
        const bossMatch=bossText.match(/(\d+)\s*\/\s*(\d+)/);
        let danger=false;

        if(bossMatch){
            const hp=Number(bossMatch[1]), max=Number(bossMatch[2]);
            danger=max>0 && hp/max<0.30;
        }

        document.body.classList.toggle('ui-boss-danger',danger);

        const weather=document.getElementById('tagWeather')?.textContent||'';
        document.body.classList.toggle('ui-weather-rain',weather.includes('雨'));

        const phase=document.getElementById('tagBossPhase')?.textContent||'';
        const bossBox=document.querySelector('#app .hp-box.boss');
        if(bossBox){
            bossBox.dataset.phase=phase;
        }
    }

    const ids=['bossHpText','tagWeather','tagBossPhase','dayVal','locVal','timeVal'];
    ids.forEach(id=>{
        const el=document.getElementById(id);
        if(!el) return;
        new MutationObserver(refreshWorldState).observe(el,{subtree:true,childList:true,characterData:true});
    });

    refreshWorldState();
})();
</script>


